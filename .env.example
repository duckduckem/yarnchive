# Supabase project URL. See docs/ARCHITECTURE.md — Environments and configuration.
VITE_SUPABASE_URL=

# Supabase anon/public key. Safe in the browser; RLS protects data.
VITE_SUPABASE_ANON_KEY=

# Used only by local import scripts. Never commit, never set in Vercel.
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection string (Project Settings > Database > Connection
# string > URI, not the pooled one). Used only by the M1.3 import script, to
# wrap all its writes in one real transaction. Never commit, never set in Vercel.
SUPABASE_DB_URL=

# Email of the one Supabase Auth user. The import script resolves this to a
# user id and stamps it on every row, since the service role bypasses RLS and
# auth.uid() won't fill it in for us.
IMPORT_USER_EMAIL=
